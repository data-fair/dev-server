{
  "name": "@data-fair/dev-server",
  "version": "2.6.1",
  "description": "A development server for optimal development experience of data-fair applications.",
  "main": "src/index.js",
  "bin": {
    "df-dev-server": "src/index.js",
    "df-dev-env": "src/dev-env.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build-watch": "tsc --watch",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "dev-test-app-minimal": "dotenv -- sh -c 'http-server test-apps/minimal --port=${APP_PORT:-3000} --cors --silent'",
    "dev-test-app-vue3": "cd test-apps/vue3 && npm run dev",
    "dev-test-app-modern": "cd test-apps/modern && npm run dev",
    "dev-zellij": "npm run build && node src/dev-env.js && dotenv -- zellij --layout .zellij.kdl",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm -w ui run build",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "build-types": "df-build-types ."
  },
  "workspaces": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koumoul-dev/df-dev-server.git"
  },
  "keywords": [
    "data-fair",
    "dev"
  ],
  "author": "Alban Mouton <alban.mouton@koumoul.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/koumoul-dev/df-dev-server/issues"
  },
  "homepage": "https://github.com/koumoul-dev/df-dev-server#readme",
  "devDependencies": {
    "@data-fair/lib-common-types": "^1.22.0",
    "@data-fair/lib-types-builder": "^1.14.3",
    "@types/config": "^4.4.0",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "http-server": "^14.1.1",
    "neostandard": "^0.13.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@data-fair/lib-express": "^1.25.0",
    "@parse5/tools": "^0.7.0",
    "chalk": "^5.6.2",
    "config": "^4.4.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "escape-string-regexp": "^5.0.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "parse5": "^8.0.1",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3"
  },
  "files": [
    "./config/**/*.js",
    "./config/**/*.d.ts",
    "./ui/dist/**/*",
    "./src/**/*.js",
    "./src/**/*.d.ts"
  ]
}
