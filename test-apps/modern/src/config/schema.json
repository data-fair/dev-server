{
  "type": "object",
  "x-exports": ["types", "resolvedSchemaJson"],
  "required": ["dataset"],
  "properties": {
    "dataset": {
      "title": "Dataset",
      "type": "object",
      "x-fromUrl": "api/v1/datasets?status=finalized&q={q}&{context.datasetFilter}",
      "x-itemsProp": "results",
      "x-itemTitle": "title",
      "x-itemKey": "href",
      "properties": {
        "id": { "type": "string" },
        "href": { "type": "string" },
        "title": { "type": "string" },
        "page": { "type": "string" },
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "type"],
            "properties": {
              "key": { "type": "string" },
              "type": { "type": "string" },
              "format": { "type": "string" },
              "title": { "type": "string" },
              "x-originalName": { "type": "string" },
              "x-group": { "type": "string" },
              "x-refersTo": { "type": ["string", "null"], "deprecated": true },
              "x-concept": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "primary": { "type": "boolean" }
                }
              },
              "x-labels": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "x-labelsRestricted": { "type": "boolean" }
            }
          }
        }
      }
    },
    "rows": {
      "type": "integer",
      "title": "Rows",
      "default": 5,
      "minimum": 5,
      "maximum": 50,
      "layout": {
        "comp": "slider",
        "step": 5,
        "props": {
          "showTicks": "always",
          "thumbLabel": true,
          "class": "mt-4"
        }
      }
    }
  }
}
